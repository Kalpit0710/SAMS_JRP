NODE_ENV=development
PORT=4000
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_VERSION=local
SCHOOL_NAME=J. R. Preparatory School
ACADEMIC_SESSION=2026-27

# Use separate databases and credentials for development and production.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=<generate-at-least-32-random-characters>
JWT_REFRESH_SECRET=<generate-a-different-random-value>

# One-time operational scripts only. Do not configure these permanently in Render.
ADMIN_INITIAL_PASSWORD=<temporary-admin-password>
SOURCE_MONGO_URI=<source-database-uri-for-import-only>
DEFAULT_TEACHER_PIN=<temporary-teacher-pin-for-import-only>